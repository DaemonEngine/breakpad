# Make unconditional expansion of undefined variables an error.  This
# helps a lot in preventing typo-related bugs.
set -u

usage_error ()
{
  echo "$0: $*" >&2
  print_usage >&2
  exit 2
}

print_usage ()
{
  cat <<END
Usage:
  test-driver --test-name NAME --log-file PATH --trs-file PATH
              [--expect-failure {yes|no}] [--color-tests {yes|no}]
              [--enable-hard-errors {yes|no}] [--]
              TEST-SCRIPT [TEST-SCRIPT-ARGUMENTS]

The '--test-name', '--log-file' and '--trs-file' options are mandatory.
See the GNU Automake documentation for information.
END
}

test_name= # Used for reporting.
log_file=  # Where to save the output of the test script.
trs_file=  # Where to save the metadata of the test run.
expect_failure=no
color_tests=no
enable_hard_errors=yes
while test $# -gt 0; do
  case $1 in
  --help) print_usage; exit $?;;
  --version) echo "test-driver $scriptversion"; exit $?;;
  --test-name) test_name=$2; shift;;
  --log-file) log_file=$2; shift;;
  --trs-file) trs_file=$2; shift;;
  --color-tests) color_tests=$2; shift;;
  --expect-failure) expect_failure=$2; shift;;
  --enable-hard-errors) enable_hard_errors=$2; shift;;
  --) shift; break;;
  -*) usage_error "invalid option: '$1'";;
   *) break;;
  esac
  shift
done

missing_opts=
test x"$test_name" = x && missing_opts="$missing_opts --test-name"
test x"$log_file"  = x && missing_opts="$missing_opts --log-file"
test x"$trs_file"  = x && missing_opts="$missing_opts --trs-file"
if test x"$missing_opts" != x; then
  usage_error "the following mandatory options are missing:$missing_opts"
fi

if test $# -eq 0; then
  usage_error "missing argument"
fi

if test $color_tests = yes; then
  # Keep this in sync with 'lib/am/check.am:$(am__tty_colors)'.
  red='[0;31m' # Red.
  grn='[0;32m' # Green.
  lgn='[1;32m' # Light green.
  blu='[1;34m' # Blue.
  mgn='[0;35m' # Magenta.
  std='[m'     # No color.
else
  red= grn= lgn= blu= mgn= std=
fi

query_showcrashdialog ()
{
  wine REQ QUERY 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog 2>/dev/null \
  | grep ShowCrashDialog \
  | sed -e 's/.* 0x//'
}

disable_showcrashdialog ()
{
  wine REG ADD 'HKCU\Software\Wine\WineDbg' /v ShowCrashDialog /t REG_DWORD /d 0 /f >/dev/null 2>&1
}

init_launcher ()
{
  # Avoid the annoying pop-up when initializing the Wine prefix.
  export DISPLAY=
  export WAYLAND_DISPLAY=

  # The /tmp directory may not be a wine-compatible filesystem.
  # The tests can run in parallel, so we cannot clean-up a shared wineprefix
  # after each test run.
  # Option 1: TESTDRIVER_WINEPREFIX=/some/path
  # Create (if missing) and reuse (and not clean-up) a given shared wineprefix.
  # Fast option, keeps wine prefix size low on parallel tests,
  if test -n "${TESTDRIVER_WINEPREFIX:-}"; then
    export WINEPREFIX="$(realpath "${TESTDRIVER_WINEPREFIX}")"
  # Option 2: TESTDRIVER_SHARED_TEMP_WINEPREFIX=true
  # Create (if missing) and reuse (and not clean-up) a shared wineprefix in /tmp.
  # Can be a security issue since executables are running from /tmp,
  # and the directory cannot be randomized.
  # Fast option, keeps wine prefix size low in /tmp on parallel tests.
  # Requires /tmp being wine-compatible.
  elif "${TESTDRIVER_SHARED_TEMP_WINEPREFIX:-false}"; then
    export WINEPREFIX="${TMPDIR:-$(dirname "$(mktemp -u)")}/wine-test-driver-$(whoami)"
  # Option 3: TESTDRIVER_TEMP_WINEPREFIX=true
  # Create and clean-up a dedicated wine prefix in /tmp for every test,
  # Can be a security issue since executables are running from /tmp.
  # Slow option, very high wine prefix size in /tmp on parallel tests.
  # Can saturate /tmp.
  elif "${TESTDRIVER_TEMP_WINEPREFIX:-false}"; then
    export WINEPREFIX="$(mktemp -d "${TMPDIR:-$(dirname "$(mktemp -u)")}/wine-test-driver-XXXXXXXX")"
    export TESTDRIVER_WINEPREFIX_CLEANUP="${TESTDRIVER_WINEPREFIX_CLEANUP:-true}"
  # Option 4: TESTDRIVER_SHARED_WINEPREFIX=true
  # Create (if missing) and reuse (and not clean-up) a shared wineprefix in the repository.
  # Secure and fast option, keeps wine prefix size low on parallel tests,
  # leaves dirt in the repository.
  # Can workaround /tmp not being wine-compatible.
  elif "${TESTDRIVER_SHARED_WINEPREFIX:-false}"; then
    export WINEPREFIX="$(realpath "${PWD}/.wine-test-driver-$(whoami)")"
  # Option 5: the default, but very slow:
  # Creates and clean-up a dedicated wine prefix in the repository for every test.
  # The most secure and reliable option, but very slow,
  # can leave dirt in the repository on unhandled interruption.
  # Slow option, very high wine prefix size in repository on parallel tests.
  else
    export WINEPREFIX="$(mktemp -d "${PWD}/.wine-test-driver-XXXXXXXX")"
    export TESTDRIVER_WINEPREFIX_CLEANUP="${TESTDRIVER_WINEPREFIX_CLEANUP:-true}"
  fi

  # Useless when created by mktemp (already done), needed otherwise.
  mkdir -p "${WINEPREFIX}" || exit $?
  chmod 700 "${WINEPREFIX}" || exit $?

  if ! test -f "${WINEPREFIX}/system.reg"; then
    wineboot --init >/dev/null 2>&1
    wineboot --wait >/dev/null 2>&1
    case "$(query_showcrashdialog)" in
      0) ;;
      *) disable_showcrashdialog;;
    esac
  fi

  wineboot --wait >/dev/null 2>&1
}

cleanup_launcher ()
{
  if "${TESTDRIVER_WINEPREFIX_CLEANUP:-false}"; then
    wineserver --kill >/dev/null 2>&1
    wineserver --wait >/dev/null 2>&1
    rm -rf "${WINEPREFIX}"
  fi
}

do_exit='cleanup_launcher; rm -f $log_file $trs_file; (exit $st); exit $st'
trap "st=129; $do_exit" 1
trap "st=130; $do_exit" 2
trap "st=141; $do_exit" 13
trap "st=143; $do_exit" 15

init_launcher

# Test script is run here. We create the file first, then append to it,
# to ameliorate tests themselves also writing to the log file. Our tests
# don't, but others can (automake bug#35762).
: >"$log_file"
# If there is no .exe extension, assume this is a wrapper script
# implementing the usage of EXE_LAUNCHER and EXE_EXT to run tests.
case "${1}" in
  *.exe) wine "$@" >>"$log_file" 2>&1;;
  *)     EXE_LAUNCHER='wine' EXE_EXT='.exe' "$@" >>"$log_file" 2>&1;;
esac
estatus=$?

cleanup_launcher

if test $enable_hard_errors = no && test $estatus -eq 99; then
  tweaked_estatus=1
else
  tweaked_estatus=$estatus
fi

case $tweaked_estatus:$expect_failure in
  0:yes) col=$red res=XPASS recheck=yes gcopy=yes;;
  0:*)   col=$grn res=PASS  recheck=no  gcopy=no;;
  77:*)  col=$blu res=SKIP  recheck=no  gcopy=yes;;
  99:*)  col=$mgn res=ERROR recheck=yes gcopy=yes;;
  *:yes) col=$lgn res=XFAIL recheck=no  gcopy=yes;;
  *:*)   col=$red res=FAIL  recheck=yes gcopy=yes;;
esac

# Report the test outcome and exit status in the logs, so that one can
# know whether the test passed or failed simply by looking at the '.log'
# file, without the need of also peaking into the corresponding '.trs'
# file (automake bug#11814).
echo "$res $test_name (exit status: $estatus)" >>"$log_file"

# Report outcome to console.
echo "${col}${res}${std}: $test_name"

# Register the test result, and other relevant metadata.
echo ":test-result: $res" > $trs_file
echo ":global-test-result: $res" >> $trs_file
echo ":recheck: $recheck" >> $trs_file
echo ":copy-in-global-log: $gcopy" >> $trs_file

